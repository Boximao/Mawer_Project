# Neon pooled URI (cloud pgvector). Do not use local Postgres on GUEST-LAP-04.
DATABASE_URL=postgresql://USER:PASS@HOST/neondb?sslmode=require
HITL_SIGNING_KEY=replace-with-long-random-string
HITL_PIN=2026
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
# Cloud rerank (preferred). Leave both blank → RRF-only, do not load local 278M on this laptop.
COHERE_API_KEY=
JINA_API_KEY=
RERANK_PROVIDER=cohere
RERANK_MODEL=rerank-v3.5
# Optional — this machine has no OpenAI key; leave blank and use demo/index.html
OPENAI_API_KEY=
GEMINI_API_KEY=
CHAT_MODEL=gpt-4.1-mini
